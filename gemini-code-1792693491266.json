            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"john.doe@fdic.gov\",\n  \"changedAt\": \"2026-10-22T14:20:00Z\",\n  \"certNumber\": 12345,\n  \"assessmentPeriod\": \"2025 Q3\",\n  \"fieldName\": \"totalAssets\",\n  \"transactionType\": \"UPDATE\",\n  \"reasonCode\": \"CORR_01\",\n  \"reasonDescription\": \"Routine quarterly assessment correction\",\n  \"previousValue\": \"5000000\",\n  \"currentValue\": \"5500000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/user-transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "user-transactions"
          ]
        },
        "description": "Appends a new user transaction log entry."
      },
      "response": []
    },
